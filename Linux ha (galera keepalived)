##Installation  (a reproduire sur chaque noeud du cluster)

##instalation de la DB 
      sudo apt-get update && sudo apt-get install mariadb-server -y
      sudo apt install galera-4 //dejà installé normalement lors de l'instalation de Maria DB mais on vérifie et installe par la même occasion si absent

##Vérification de la présence de "60-galera.cnf"
    ls /etc/mysql/mariadb.conf.d/
  on édite le fichier via nano (penser a éssayer micro) 
  Le fichier d'origine est un template donc commenté en toutes lignes, voici ce a quoi il doit ressembler in fine

[galera]
# Mandatory settings
wsrep_on = ON                                                           #activer la réplication en écriture via le provider wsrep
wsrep_provider = /usr/lib/galera/libgalera_smm.so                       #emplacement de la librairie wsrep
wsrep_cluster_name = "NomDeCluster"                                     #nom du cluster, doit être identique sur tous les nœuds de votre cluster Galera
wsrep_cluster_address = gcomm://AdresseIP1,AdressIP2,AdresseIP3         #adresses IP (ou le nom, mais préférez l'adresse IP) des différents nœuds du cluster (séparées par une virgule) donc ici les adresses IP de mes trois serveurs 
binlog_format = row                                                     #format des logs en ROW, par défaut
default_storage_engine = InnoDB                                         #moteur de stockage de la base de données
innodb_autoinc_lock_mode = 2                                            #mode pour l'auto-incrémentation, 2 est recommandé, mais les autres valeurs possibles sont "0" ou "1"
innodb_force_primary_key = 1                                            #s'assurer que toutes les tables ont bien une clé primaire pour éviter les erreurs

# Allow server to accept connections on all interfaces.
bind-address = 0.0.0.0                                                  #accepter les connexions sur toutes les interfaces

# Optional settings
#wsrep_slave_threads = 1
#innodb_flush_log_at_trx_commit = 0
log_error = /var/log/mysql/error-galera.log                            #emplacements des logs d'erreur

Ce fichier sera a reproduire a l'identique sur tous les noeuds


##Démarage du cluster Galera
//Dans le but d'initialiser notre cluster Galera avec son nœud primaire, nous allons poursuivre sur le serveur SRV-DEB-1 qui contient notre configuration (60-galera.cnf) et la base de données à répliquer. Commençons par stopper MariaDB :

sudo systemctl stop mariadb
//Une fois que c'est fait (et c'est important d'arrêter MariaDB), démarrez l'initialisation du cluster Galera avec cette commande :

sudo galera_new_cluster
//Maintenant, on va se connecter à notre instance locale MariaDB pour regarder combien de nœuds constituent notre cluster : en toute logique un seul.

mysql -u root -p
//Exécutez la requête suivante pour récupérer la valeur de la propriété "wsrep_cluster_size" :

show status like 'wsrep_cluster_size';
//doit retourner 1 so "0" 
show global status like 'wsrep%';

