#!/usr/bin/env bash
#
# backup_incremental.sh
# Sauvegarde incrémentielle par snapshots (rsync + hard links).
#
# Principe : chaque exécution crée un dossier horodaté qui ressemble à une
# sauvegarde complète, mais les fichiers inchangés sont des liens physiques
# vers le snapshot précédent (--link-dest). Seuls les fichiers modifiés
# consomment de l'espace disque.
#
# Utilisation :
#   ./backup_incremental.sh -s /home/user -s /etc -d /mnt/backup [-r 30] [-e exclusions.txt] [-n]
#
# Options :
#   -s DIR   Dossier source à sauvegarder (répétable)
#   -d DIR   Dossier de destination des sauvegardes (obligatoire)
#   -r N     Rétention en jours (défaut : 30)
#   -e FILE  Fichier de motifs d'exclusion pour rsync (optionnel)
#   -l FILE  Fichier de log (défaut : ~/backup_incremental.log)
#   -n       Simulation (dry-run), aucune modification
#   -h       Aide
#
# Restauration : copier simplement le contenu d'un snapshot, par exemple
#   rsync -a /mnt/backup/2026-10-01_020000/home/user/ /home/user/

set -euo pipefail

# ---------- Valeurs par défaut ----------
SOURCES=()
BACKUP_ROOT=""
RETENTION_DAYS=30
EXCLUDE_FILE=""
LOG_FILE="${HOME}/backup_incremental.log"
DRY_RUN=0

usage() {
    sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

log() {
    local msg
    msg="$(date '+%Y-%m-%d %H:%M:%S') [$1] ${*:2}"
    echo "$msg" | tee -a "$LOG_FILE" >&2
}

# ---------- Lecture des arguments ----------
while getopts ":s:d:r:e:l:nh" opt; do
    case "$opt" in
        s) SOURCES+=("$OPTARG") ;;
        d) BACKUP_ROOT="${OPTARG%/}" ;;
        r) RETENTION_DAYS="$OPTARG" ;;
        e) EXCLUDE_FILE="$OPTARG" ;;
        l) LOG_FILE="$OPTARG" ;;
        n) DRY_RUN=1 ;;
        h) usage 0 ;;
        :) echo "Option -$OPTARG : argument manquant" >&2; usage 1 ;;
        \?) echo "Option inconnue : -$OPTARG" >&2; usage 1 ;;
    esac
done

# ---------- Vérifications ----------
command -v rsync >/dev/null 2>&1 || { echo "rsync est requis (apt install rsync)" >&2; exit 1; }

[[ ${#SOURCES[@]} -gt 0 ]] || { echo "Aucune source indiquée (-s)" >&2; usage 1; }
[[ -n "$BACKUP_ROOT" ]]    || { echo "Aucune destination indiquée (-d)" >&2; usage 1; }
[[ "$RETENTION_DAYS" =~ ^[0-9]+$ ]] || { echo "La rétention doit être un nombre entier" >&2; exit 1; }

for src in "${SOURCES[@]}"; do
    [[ -d "$src" ]] || { echo "Source introuvable : $src" >&2; exit 1; }
done

[[ -z "$EXCLUDE_FILE" || -f "$EXCLUDE_FILE" ]] || { echo "Fichier d'exclusion introuvable : $EXCLUDE_FILE" >&2; exit 1; }

mkdir -p "$BACKUP_ROOT"
mkdir -p "$(dirname "$LOG_FILE")"

# ---------- Verrou : empêche deux sauvegardes simultanées ----------
LOCK_FILE="${BACKUP_ROOT}/.backup.lock"
exec 200>"$LOCK_FILE"
if ! flock -n 200; then
    log ERROR "Une sauvegarde est déjà en cours (verrou : $LOCK_FILE)"
    exit 1
fi

# ---------- Variables de la sauvegarde ----------
TIMESTAMP="$(date +%Y-%m-%d_%H%M%S)"
INCOMPLETE_DIR="${BACKUP_ROOT}/.incomplete-${TIMESTAMP}"
FINAL_DIR="${BACKUP_ROOT}/${TIMESTAMP}"
LATEST_LINK="${BACKUP_ROOT}/latest"

# Nettoyage des sauvegardes interrompues lors d'exécutions précédentes
if [[ $DRY_RUN -eq 0 ]]; then
    find "$BACKUP_ROOT" -maxdepth 1 -type d -name '.incomplete-*' -exec rm -rf {} + 2>/dev/null || true
fi

# ---------- Construction de la commande rsync ----------
# -a : archive (droits, dates, liens symboliques, propriétaire…)
# -H : conserve les liens physiques existants
# -R : conserve le chemin complet des sources (plusieurs sources possibles)
# Ajoutez -A -X pour les ACL et attributs étendus (si le système de fichiers les supporte)
RSYNC_OPTS=(-aHR --delete --numeric-ids --stats)
[[ $DRY_RUN -eq 1 ]] && RSYNC_OPTS+=(--dry-run --itemize-changes)
[[ -n "$EXCLUDE_FILE" ]] && RSYNC_OPTS+=(--exclude-from="$EXCLUDE_FILE")

# Si un snapshot précédent existe, les fichiers inchangés seront liés dessus
if [[ -e "$LATEST_LINK" ]]; then
    RSYNC_OPTS+=(--link-dest="$(readlink -f "$LATEST_LINK")")
    log INFO "Sauvegarde incrémentielle basée sur : $(readlink -f "$LATEST_LINK")"
else
    log INFO "Aucun snapshot précédent : première sauvegarde complète"
fi

# ---------- Exécution ----------
log INFO "Début de la sauvegarde -> $FINAL_DIR"
log INFO "Sources : ${SOURCES[*]}"

set +e
rsync "${RSYNC_OPTS[@]}" "${SOURCES[@]}" "$INCOMPLETE_DIR/" >>"$LOG_FILE" 2>&1
RSYNC_CODE=$?
set -e

# Code 24 = fichiers disparus pendant la copie (courant, non bloquant)
if [[ $RSYNC_CODE -ne 0 && $RSYNC_CODE -ne 24 ]]; then
    log ERROR "rsync a échoué (code $RSYNC_CODE). Voir $LOG_FILE"
    exit "$RSYNC_CODE"
fi
[[ $RSYNC_CODE -eq 24 ]] && log WARN "Certains fichiers ont disparu pendant la sauvegarde (code 24)"

if [[ $DRY_RUN -eq 1 ]]; then
    log INFO "Simulation terminée, aucune modification effectuée"
    exit 0
fi

# ---------- Validation du snapshot ----------
mv "$INCOMPLETE_DIR" "$FINAL_DIR"
ln -sfn "$FINAL_DIR" "$LATEST_LINK"
log INFO "Snapshot créé : $FINAL_DIR ($(du -sh "$FINAL_DIR" | cut -f1) apparents)"

# ---------- Rotation : suppression des snapshots trop anciens ----------
# Le snapshot le plus récent n'est jamais supprimé.
log INFO "Rotation : suppression des snapshots de plus de ${RETENTION_DAYS} jours"
while IFS= read -r old; do
    [[ "$old" == "$(readlink -f "$LATEST_LINK")" ]] && continue
    log INFO "Suppression de $old"
    rm -rf "$old"
done < <(find "$BACKUP_ROOT" -maxdepth 1 -type d \
            -regex '.*/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}_[0-9]\{6\}' \
            -mtime +"$RETENTION_DAYS")

log INFO "Sauvegarde terminée avec succès"
